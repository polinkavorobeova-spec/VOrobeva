<Window x:Class="Vorobeva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор — Воробьева" Height="520" Width="380"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="ExpressionText" HorizontalAlignment="Right" FontSize="22" Foreground="Gray" Margin="10,10,10,0" MinHeight="30"/>
        <TextBlock Grid.Row="1" Name="ResultText" HorizontalAlignment="Right" FontSize="46" FontWeight="Bold" Text="0" Margin="10,0,10,10" MinHeight="60"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="C"  Click="ClearButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="0" Grid.Column="1" Content="⌫" Click="BackspaceButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="0" Grid.Column="2" Content="^" Tag="^" Click="OperatorButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="0" Grid.Column="3" Content="÷" Tag="/" Click="OperatorButton_Click" FontSize="24" Margin="5"/>

            <Button Grid.Row="1" Grid.Column="0" Content="7" Tag="7" Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8" Tag="8" Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9" Tag="9" Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="1" Grid.Column="3" Content="×" Tag="*" Click="OperatorButton_Click" FontSize="24" Margin="5"/>

            <Button Grid.Row="2" Grid.Column="0" Content="4" Tag="4" Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5" Tag="5" Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6" Tag="6" Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="2" Grid.Column="3" Content="−" Tag="-" Click="OperatorButton_Click" FontSize="24" Margin="5"/>

            <Button Grid.Row="3" Grid.Column="0" Content="1" Tag="1" Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2" Tag="2" Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="3" Grid.Column="2" Content="3" Tag="3" Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="3" Grid.Column="3" Content="+" Tag="+" Click="OperatorButton_Click" FontSize="24" Margin="5"/>

            <Button Grid.Row="4" Grid.Column="0" Content="0" Tag="0" Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="4" Grid.Column="1" Content="." Tag="." Click="DigitButton_Click" FontSize="24" Margin="5"/>
            <Button Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Content="=" Click="EqualsButton_Click" FontSize="24" Margin="5"/>
        </Grid>
    </Grid>
</Window>